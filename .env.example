# ── GitHub OAuth App ───────────────────────────────────────────────────────────
# Crear en: https://github.com/settings/applications/new
# Authorization callback URL: https://tudominio.com/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── Anthropic API ──────────────────────────────────────────────────────────────
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI API (fallback si Anthropic falla) ───────────────────────────────────
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Gemini API (fallback si OpenAI falla) ─────────────────────────────────────
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Groq API (voice assistant — parseo de voz, gratis) ────────────────────────
# Obtener en: https://console.groq.com/ (gratis, Llama 3.3-70B)
GROQ_API_KEY=gsk_...

# ── ElevenLabs API (TTS natural — voz humana) ─────────────────────────────────
# Obtener en: https://elevenlabs.io/ (Starter $6/mes, 30k chars/mes)
# VoiceId por defecto: Rachel (21m00Tcm4TlvDq8ikWAM) — multilingual, español natural
ELEVENLABS_API_KEY=sk_...
# Agent ID del agente conversacional (ElevenAgents) que atiende el dashboard.
# No es secreto — se embebe en el HTML público del widget.
ELEVENLABS_AGENT_ID=agent_6001kwnzg7pye0hvqrdnc421nv9d

# ── Seguridad ──────────────────────────────────────────────────────────────────
# Clave para cifrar contraseñas de VPS (mínimo 32 caracteres aleatorios)
ENCRYPTION_KEY=cambia_esto_por_una_clave_segura_de_32_chars

# ── Base de datos ──────────────────────────────────────────────────────────────
# Solo para docker-compose (no necesario si usas la connection string en appsettings)
DB_PASSWORD=ProjectForge!23

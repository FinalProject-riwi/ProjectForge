@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";
}

<div class="auth-page">
    <!-- Background glow -->
    <div style="position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden" aria-hidden="true">
        <div style="position:absolute;width:600px;height:600px;top:-150px;left:50%;transform:translateX(-50%);background:radial-gradient(circle,rgba(99,102,241,.1),transparent 65%)"></div>
    </div>

    <div class="auth-card" style="position:relative;z-index:1">
        <div class="auth-logo">
            <img src="/img/logo.jpg" alt="TabBuilder" style="width:46px;height:46px;border-radius:12px;object-fit:cover;box-shadow:0 6px 20px rgba(99,102,241,.3)" />
            <h1>Tab<strong>Builder</strong></h1>
        </div>
        <p class="auth-subtitle">
            Conecta tu cuenta de GitHub para comenzar a generar proyectos automáticamente.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="session-error">
                ⚠️ @TempData["Error"]
            </div>
        }

        <a asp-controller="Auth" asp-action="GitHubLogin" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn btn-primary btn-github">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            Continuar con GitHub
        </a>

        <div class="auth-permissions">
            <p class="perm-title">TabBuilder solicitará permisos para:</p>
            <ul>
                <li>Leer tu perfil de GitHub (nombre, avatar)</li>
                <li>Crear repositorios en tu cuenta</li>
                <li>Hacer push de código a repositorios nuevos</li>
            </ul>
        </div>

        <p style="margin-top:1.5rem;font-size:.75rem;color:var(--text-muted);line-height:1.6">
            Al continuar, aceptas nuestros <a href="/terms" style="color:var(--text-dim)">Términos</a> y 
            <a href="/privacy" style="color:var(--text-dim)">Política de privacidad</a>.
        </p>
    </div>
</div>

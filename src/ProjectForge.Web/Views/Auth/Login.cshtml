@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">
            <span style="font-size:2.5rem">⚙</span>
            <h1>Project<strong>Forge</strong></h1>
        </div>
        <p class="auth-subtitle">
            Conecta tu cuenta de GitHub para comenzar a generar proyectos automáticamente.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="session-error">
                ⚠️ @TempData["Error"]
            </div>
        }

        <a asp-controller="Auth" asp-action="GitHubLogin" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn btn-primary btn-github">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            Continuar con GitHub
        </a>

        <div class="auth-permissions">
            <p class="perm-title">ProjectForge solicitará permisos para:</p>
            <ul>
                <li>✓ Leer tu perfil de GitHub (nombre, avatar)</li>
                <li>✓ Crear repositorios en tu cuenta</li>
                <li>✓ Hacer push de código a repositorios nuevos</li>
            </ul>
        </div>
    </div>
</div>

<style>
.auth-page { display: flex; align-items: center; justify-content: center; min-height: 70vh; }
.auth-card {
    width: 100%; max-width: 420px; padding: 2.5rem;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px;
    text-align: center;
}
.auth-logo { display: flex; align-items: center; justify-content: center; gap: .75rem; margin-bottom: 1rem; font-size: 1.5rem; font-family: var(--font-mono); }
.auth-subtitle { color: var(--text-muted); margin-bottom: 2rem; line-height: 1.6; }
.btn-github { width: 100%; justify-content: center; padding: .85rem; font-size: 1rem; }
.auth-permissions {
    margin-top: 1.5rem; padding: 1rem; border-radius: var(--radius);
    background: var(--bg-elevated); border: 1px solid var(--border); text-align: left;
}
.perm-title { font-size: .8rem; color: var(--text-muted); margin-bottom: .5rem; }
.session-error { background: rgba(239,68,68,.12); border: 1px solid #ef4444; color: #fca5a5; border-radius: 8px; padding: .75rem 1rem; margin-bottom: 1.25rem; font-size: .88rem; line-height: 1.5; }
.auth-permissions ul { list-style: none; font-size: .82rem; color: var(--text-dim); line-height: 1.8; }
</style>

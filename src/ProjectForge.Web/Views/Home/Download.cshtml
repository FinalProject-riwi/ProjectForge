@{
    ViewData["Title"] = "Descargar – TabBuilder";
    Layout = "_Layout";
}

<div style="max-width:700px;margin:0 auto;padding:3rem 1.5rem;text-align:center">
    <img src="~/img/logo.jpg" alt="TabBuilder" style="width:80px;height:80px;border-radius:18px;margin:0 auto 1.5rem;box-shadow:0 8px 32px rgba(59,130,246,.25)" />

    <h1 style="font-size:2rem;font-weight:800;letter-spacing:-.02em;margin-bottom:.6rem">Instala TabBuilder</h1>
    <p style="color:var(--text-muted);margin-bottom:3rem;max-width:500px;margin-left:auto;margin-right:auto;line-height:1.7">
        TabBuilder es una Progressive Web App. No necesitas tienda de aplicaciones — instálala directamente desde tu navegador en cualquier plataforma.
    </p>

    <!-- Desktop install -->
    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:2rem;margin-bottom:1.25rem" class="reveal">
        <div style="font-size:1.8rem;margin-bottom:.75rem">🖥️</div>
        <h2 style="font-size:1.1rem;font-weight:600;margin-bottom:.5rem">macOS / Windows / Linux</h2>
        <p style="color:var(--text-muted);font-size:.875rem;margin-bottom:1.25rem;line-height:1.65">
            En Chrome, Edge o Brave: busca el botón de instalación en la barra de direcciones (icono de descarga o pantalla) y haz clic en "Instalar".
        </p>
        <button class="btn btn-primary" id="desktop-install-btn" style="display:none">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Instalar ahora
        </button>
        <p id="desktop-fallback" style="font-size:.82rem;color:var(--text-muted)">
            Si no ves el botón de instalación, asegúrate de usar Chrome, Edge o Brave en versión reciente.
        </p>
    </div>

    <!-- iOS -->
    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:2rem;margin-bottom:1.25rem" class="reveal reveal-delay-1">
        <div style="font-size:1.8rem;margin-bottom:.75rem">📱</div>
        <h2 style="font-size:1.1rem;font-weight:600;margin-bottom:.5rem">iPhone / iPad</h2>
        <p style="color:var(--text-muted);font-size:.875rem;margin-bottom:.75rem;line-height:1.65">
            Abre TabBuilder en Safari, toca el botón Compartir y selecciona "Añadir a la pantalla de inicio".
        </p>
        <div style="display:flex;align-items:center;justify-content:center;gap:1rem;font-size:.85rem;color:var(--text-dim)">
            <span style="padding:.3rem .75rem;background:var(--bg-elevated);border-radius:999px;border:1px solid var(--border)">1. Abrir en Safari</span>
            <span style="color:var(--text-muted)">→</span>
            <span style="padding:.3rem .75rem;background:var(--bg-elevated);border-radius:999px;border:1px solid var(--border)">2. Compartir</span>
            <span style="color:var(--text-muted)">→</span>
            <span style="padding:.3rem .75rem;background:var(--bg-elevated);border-radius:999px;border:1px solid var(--border)">3. Añadir al inicio</span>
        </div>
    </div>

    <!-- Android -->
    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:2rem;margin-bottom:2rem" class="reveal reveal-delay-2">
        <div style="font-size:1.8rem;margin-bottom:.75rem">🤖</div>
        <h2 style="font-size:1.1rem;font-weight:600;margin-bottom:.5rem">Android</h2>
        <p style="color:var(--text-muted);font-size:.875rem;margin-bottom:.75rem;line-height:1.65">
            En Chrome, toca el menú de tres puntos y selecciona "Añadir a pantalla de inicio" o "Instalar aplicación".
        </p>
        <div style="display:flex;align-items:center;justify-content:center;gap:1rem;font-size:.85rem;color:var(--text-dim);flex-wrap:wrap">
            <span style="padding:.3rem .75rem;background:var(--bg-elevated);border-radius:999px;border:1px solid var(--border)">1. Chrome → Menú ⋮</span>
            <span style="color:var(--text-muted)">→</span>
            <span style="padding:.3rem .75rem;background:var(--bg-elevated);border-radius:999px;border:1px solid var(--border)">2. Instalar aplicación</span>
        </div>
    </div>

    <p style="font-size:.82rem;color:var(--text-muted)" class="reveal">
        Una vez instalada, TabBuilder funciona como una app nativa con acceso directo desde tu escritorio o pantalla de inicio.
        Sigue necesitando conexión a internet para generar proyectos.
    </p>

    <div style="margin-top:2rem" class="reveal">
        <a href="/" class="btn btn-ghost">Volver al inicio</a>
    </div>
</div>

@section Scripts {
<script>
let deferredInstall = null;

window.addEventListener('beforeinstallprompt', function (e) {
    e.preventDefault();
    deferredInstall = e;
    const btn = document.getElementById('desktop-install-btn');
    const fallback = document.getElementById('desktop-fallback');
    if (btn) btn.style.display = 'inline-flex';
    if (fallback) fallback.style.display = 'none';
});

document.getElementById('desktop-install-btn')?.addEventListener('click', async function () {
    if (!deferredInstall) return;
    deferredInstall.prompt();
    const { outcome } = await deferredInstall.userChoice;
    if (outcome === 'accepted') {
        this.textContent = 'Instalando…';
        this.disabled = true;
    }
    deferredInstall = null;
});

window.addEventListener('appinstalled', function () {
    document.getElementById('desktop-install-btn').textContent = 'Instalado';
    document.getElementById('desktop-install-btn').disabled = true;
});
</script>
}

@{
    // Signal to layout that this page needs full-width
    ViewData["FullWidth"] = true;
}

@{
    ViewData["Title"] = "API v1 – TabBuilder";
    Layout = "_Layout";
    @* var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}"; *@
    var baseUrl = $"http://localhost:5001/api/v1";
}

@* ─── tipos locales para evitar el bug de tuplas anónimas en foreach ─── *@
@functions {
    record ApiEndpoint(string Method, string Path, string Summary, bool RequiresAuth, string? Notes = null, string? Body = null);
    record ApiGroup(string Id, string Label, System.Collections.Generic.List<ApiEndpoint> Endpoints);
}

@{
    // NOTA: Path NO debe llevar "/" inicial, las plantillas de abajo ya lo agregan
    // (antes: "/catalog/architectures" -> generaba "/api/v1//catalog/architectures")
    var apiGroups = new System.Collections.Generic.List<ApiGroup>
    {
        new ApiGroup("auth", "Autenticación", new()
        {
            new ApiEndpoint("GET", "auth/me", "Información del usuario autenticado", true)
        }),
        new ApiGroup("catalog", "Catálogo", new()
        {
            new ApiEndpoint("GET",  "catalog/architectures",                    "Arquitecturas disponibles (C#, Java, Python…)", false),
            new ApiEndpoint("GET",  "catalog/frameworks/{architecture}",        "Frameworks para una arquitectura dada",         false, "architecture: DotNet | Java | Python | Php | JavaScript | TypeScript"),
            new ApiEndpoint("GET",  "catalog/databases",                        "Bases de datos disponibles",                    false),
            new ApiEndpoint("GET",  "catalog/infrastructure",                   "Opciones de infraestructura",                   false),
            new ApiEndpoint("GET",  "catalog/patterns/{arch}/{framework}",      "Patrones de diseño para el stack",              false),
            new ApiEndpoint("GET",  "catalog/libraries/{arch}/{framework}",     "Librerías disponibles para el stack",           false)
        }),
        new ApiGroup("ia", "IA", new()
        {
            new ApiEndpoint("POST", "ai/suggest", "Sugerencias de patrones y librerías con IA", true,
                null,
                "{ \"architecture\": \"DotNet\", \"framework\": \"AspNetCoreWebApi\", \"database\": \"PostgreSQL\" }")
        }),
        new ApiGroup("projects", "Proyectos", new()
        {
            new ApiEndpoint("GET",    "projects",               "Lista proyectos del usuario autenticado",  true),
            new ApiEndpoint("POST",   "projects",               "Crea y registra un nuevo proyecto",        true, null,
                "{\n  \"projectName\": \"mi-api\",\n  \"description\": \"API REST con FastAPI\",\n  \"architecture\": \"Python\",\n  \"framework\": \"FastAPI\",\n  \"database\": \"PostgreSQL\",\n  \"infrastructure\": \"DockerCompose\",\n  \"patterns\": [\"CleanArchitecture\"],\n  \"libraries\": [\"sqlalchemy\", \"alembic\"],\n  \"createPrivateRepo\": false\n}"),
            new ApiEndpoint("GET",    "projects/{id}",          "Detalle completo del proyecto",            true),
            new ApiEndpoint("GET",    "projects/{id}/logs",     "Logs de generación del proyecto",          true),
            new ApiEndpoint("POST",   "projects/{id}/generate", "Inicia la generación del proyecto",        true),
            new ApiEndpoint("DELETE", "projects/{id}",          "Elimina permanentemente el proyecto",      true)
        })
    };

    int epIndex = 0;
}

<div class="apidoc-wrap">

    <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
    <aside class="apidoc-sidebar" id="apidoc-sidebar">
        <div class="apidoc-sidebar-header">
            <img src="~/img/logo.jpg" alt="TabBuilder" style="width:28px;height:28px;border-radius:7px" />
            <div>
                <div style="font-weight:700;font-size:.9rem;font-family:var(--font-mono)">TabBuilder</div>
                <div style="font-size:.72rem;color:var(--text-muted)">REST API v1</div>
            </div>
        </div>

        <div class="apidoc-sidebar-section">
            <div class="apidoc-sidebar-label">Información</div>
            <a class="apidoc-sidebar-link" href="#overview">Descripción general</a>
            <a class="apidoc-sidebar-link" href="#auth-info">Autenticación</a>
            <a class="apidoc-sidebar-link" href="#base-url">Base URL</a>
        </div>

        @foreach (var grp in apiGroups)
        {
            <div class="apidoc-sidebar-section">
                <div class="apidoc-sidebar-label">@grp.Label.ToUpperInvariant()</div>
                @foreach (var ep in grp.Endpoints)
                {
                    <a class="apidoc-sidebar-link apidoc-sidebar-ep" href="#ep-@grp.Id-@ep.Method.ToLower()-@ep.Path.Replace("/","_").Replace("{","").Replace("}","")">
                        <span class="apidoc-badge-mini apidoc-badge-@ep.Method.ToLower()">@ep.Method</span>
                        <span class="apidoc-ep-label">/@ep.Path</span>
                    </a>
                }
            </div>
        }

        <div class="apidoc-sidebar-section">
            <div class="apidoc-sidebar-label">Real-time</div>
            <a class="apidoc-sidebar-link" href="#signalr">SignalR Hub</a>
        </div>
    </aside>

    <!-- ── Main content ─────────────────────────────────────────────────── -->
    <main class="apidoc-main">

        <!-- Overview -->
        <section class="apidoc-section" id="overview">
            <div class="apidoc-section-title">
                <h1 class="apidoc-h1">
                    TabBuilder REST API
                    <span class="apidoc-version-badge">v1</span>
                </h1>
                <p class="apidoc-desc">
                    API RESTful para integración con clientes externos (Flutter, React, CLI).
                    Todos los endpoints retornan JSON. La autenticación usa Bearer Token de GitHub.
                </p>
                <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.75rem">
                    <span class="apidoc-tag green">OpenAPI compatible</span>
                    <span class="apidoc-tag blue">Bearer Auth</span>
                    <span class="apidoc-tag purple">SignalR real-time</span>
                </div>
            </div>
        </section>

        <!-- Base URL -->
        <section class="apidoc-section" id="base-url">
            <h2 class="apidoc-h2">Base URL</h2>
            <div class="apidoc-url-box">
                <span class="apidoc-url-scheme">https</span>
                <span class="apidoc-url-text">@baseUrl</span>
                <button class="apidoc-copy-btn" onclick="copyText('@baseUrl', this)" title="Copiar URL">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                </button>
            </div>
        </section>

        <!-- Auth -->
        <section class="apidoc-section" id="auth-info">
            <h2 class="apidoc-h2">Autenticación</h2>
            <p class="apidoc-desc">
                Los endpoints protegidos requieren el <strong>GitHub access token</strong> en el header:
            </p>
            <div class="apidoc-code">Authorization: Bearer &lt;github_access_token&gt;</div>
            <div class="apidoc-callout apidoc-callout-warning">
                Los endpoints marcados con <strong>Auth requerida</strong> devuelven <code>401</code> si el token es inválido o falta el header.
            </div>
        </section>

        <!-- Endpoint groups -->
        @foreach (var grp in apiGroups)
        {
            <section class="apidoc-group" id="group-@grp.Id">
                <div class="apidoc-group-header">
                    <h2 class="apidoc-group-title">@grp.Label</h2>
                    <span class="apidoc-group-count">@grp.Endpoints.Count endpoint@(grp.Endpoints.Count != 1 ? "s" : "")</span>
                </div>

                @foreach (var ep in grp.Endpoints)
                {
                    var epId = $"ep-{grp.Id}-{ep.Method.ToLower()}-{ep.Path.Replace("/","_").Replace("{","").Replace("}","")}";
                    var panelId = $"panel-{epIndex}";
                    epIndex++;

                    <div class="apidoc-endpoint" id="@epId">
                        <!-- Endpoint header row (clickable) -->
                        <div class="apidoc-ep-header" onclick="togglePanel('@panelId', this)">
                            <span class="apidoc-method apidoc-method-@ep.Method.ToLower()">@ep.Method</span>
                            <code class="apidoc-path">/api/v1/@ep.Path</code>
                            <span class="apidoc-summary">@ep.Summary</span>
                            <div class="apidoc-ep-meta">
                                @if (ep.RequiresAuth)
                                {
                                    <span class="apidoc-auth-badge">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                                        Auth
                                    </span>
                                }
                                else
                                {
                                    <span class="apidoc-public-badge">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 010 20"/></svg>
                                        Público
                                    </span>
                                }
                            </div>
                            <svg class="apidoc-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                        </div>

                        <!-- Expandable panel -->
                        <div class="apidoc-ep-panel" id="@panelId">
                            <div class="apidoc-ep-body">
                                @if (!string.IsNullOrEmpty(ep.Notes))
                                {
                                    <div class="apidoc-callout apidoc-callout-info" style="margin-bottom:1rem">
                                        <strong>Parámetro:</strong> @ep.Notes
                                    </div>
                                }

                                <!-- Try it section -->
                                <div class="apidoc-try-section">
                                    <div class="apidoc-try-header">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                        Probar endpoint
                                    </div>

                                    <div class="apidoc-try-body">
                                        <!-- URL preview -->
                                        <div class="apidoc-try-row">
                                            <label class="apidoc-try-label">URL</label>
                                            <div class="apidoc-try-url-bar">
                                                <span class="apidoc-method-mini apidoc-method-@ep.Method.ToLower()">@ep.Method</span>
                                                <code class="apidoc-try-url-text" id="url-@panelId">@baseUrl/@ep.Path</code>
                                            </div>
                                        </div>

                                        @if (ep.RequiresAuth)
                                        {
                                            <div class="apidoc-try-row">
                                                <label class="apidoc-try-label">Bearer Token</label>
                                                <input
                                                    type="password"
                                                    class="apidoc-try-input"
                                                    placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
                                                    id="token-@panelId"
                                                />
                                            </div>
                                        }

                                        @if (ep.Path.Contains("{"))
                                        {
                                            <div class="apidoc-try-row">
                                                <label class="apidoc-try-label">Path params</label>
                                                <input
                                                    type="text"
                                                    class="apidoc-try-input apidoc-try-param"
                                                    placeholder="@ep.Path"
                                                    data-base-url="@baseUrl/@ep.Path"
                                                    data-url-target="url-@panelId"
                                                    oninput="updateUrl(this)"
                                                />
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(ep.Body))
                                        {
                                            <div class="apidoc-try-row">
                                                <label class="apidoc-try-label">Body (JSON)</label>
                                                <textarea
                                                    class="apidoc-try-textarea"
                                                    id="body-@panelId"
                                                    rows="@(ep.Body.Split('\n').Length + 1)"
                                                >@ep.Body</textarea>
                                            </div>
                                        }

                                        <div class="apidoc-try-actions">
                                            <button
                                                class="apidoc-exec-btn"
                                                onclick="executeRequest('@panelId', '@ep.Method', '@baseUrl/@ep.Path', @(ep.RequiresAuth ? "true" : "false"), @(!string.IsNullOrEmpty(ep.Body) ? "true" : "false"))"
                                            >
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/></svg>
                                                Ejecutar
                                            </button>
                                            <button class="apidoc-clear-btn" onclick="clearResponse('@panelId')">Limpiar</button>
                                        </div>

                                        <!-- Response -->
                                        <div class="apidoc-response" id="res-@panelId" style="display:none">
                                            <div class="apidoc-res-header">
                                                <span class="apidoc-res-title">Respuesta</span>
                                                <span class="apidoc-res-status" id="status-@panelId"></span>
                                                <span class="apidoc-res-time" id="time-@panelId"></span>
                                                <button class="apidoc-copy-btn" onclick="copyResponse('@panelId')">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                                                </button>
                                            </div>
                                            <pre class="apidoc-res-body" id="resdata-@panelId"></pre>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        <!-- SignalR -->
        <section class="apidoc-section" id="signalr">
            <h2 class="apidoc-h2">Tiempo real — SignalR</h2>
            <p class="apidoc-desc">La generación emite eventos en tiempo real vía WebSockets. Hub:</p>
            <div class="apidoc-url-box" style="margin-bottom:1rem">
                <span class="apidoc-url-scheme">ws</span>
                <span class="apidoc-url-text">@(baseUrl.Replace("/api/v1", ""))/hubs/generation</span>
                <button class="apidoc-copy-btn" onclick="copyText('@(baseUrl.Replace("/api/v1", ""))/hubs/generation', this)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                </button>
            </div>
            <div class="apidoc-endpoint" style="border-radius:10px">
                <div class="apidoc-ep-header" style="cursor:default">
                    <span class="apidoc-method" style="background:rgba(139,92,246,.2);color:#a78bfa;border-color:rgba(139,92,246,.3)">EVENT</span>
                    <code class="apidoc-path">ReceiveLog</code>
                    <span class="apidoc-summary">Emite cada línea de log durante la generación</span>
                    <code style="font-family:var(--font-mono);font-size:.72rem;color:var(--text-muted)">(string step, string message, bool isError)</code>
                </div>
            </div>
            <div class="apidoc-endpoint" style="border-radius:10px;margin-top:.5rem">
                <div class="apidoc-ep-header" style="cursor:default">
                    <span class="apidoc-method" style="background:rgba(59,130,246,.2);color:#60a5fa;border-color:rgba(59,130,246,.3)">EVENT</span>
                    <code class="apidoc-path">StatusChanged</code>
                    <span class="apidoc-summary">Emite cuando el estado del proyecto cambia</span>
                    <code style="font-family:var(--font-mono);font-size:.72rem;color:var(--text-muted)">(int projectId, string status)</code>
                </div>
            </div>
        </section>

    </main>
</div>

@section Scripts {
<style>
/* ── API Docs layout ────────────────────────────────────────────────────────── */
.apidoc-wrap {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 0;
    min-height: calc(100vh - 130px);
    max-width: 1300px;
    margin: -2rem auto 0;
    padding: 0;
}

/* ── Sidebar ────────────────────────────────────────────────────────────────── */
.apidoc-sidebar {
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
    border-right: 1px solid var(--border);
    padding: 1.25rem 0;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
}
.apidoc-sidebar::-webkit-scrollbar { width: 4px; }
.apidoc-sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

.apidoc-sidebar-header {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .5rem 1.25rem 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: .75rem;
}

.apidoc-sidebar-section { margin-bottom: .5rem; }

.apidoc-sidebar-label {
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: .5rem 1.25rem .25rem;
}

.apidoc-sidebar-link {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .35rem 1.25rem;
    font-size: .82rem;
    color: var(--text-dim);
    text-decoration: none;
    transition: all .15s;
    border-left: 2px solid transparent;
}
.apidoc-sidebar-link:hover {
    color: var(--text);
    background: var(--bg-elevated);
    border-left-color: var(--border-active);
}
.apidoc-sidebar-link.active {
    color: var(--primary);
    border-left-color: var(--primary);
    background: var(--primary-glow);
}

.apidoc-sidebar-ep { gap: .4rem; }
.apidoc-ep-label {
    font-family: var(--font-mono);
    font-size: .73rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.apidoc-badge-mini {
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 700;
    padding: .1rem .35rem;
    border-radius: 3px;
    flex-shrink: 0;
    min-width: 38px;
    text-align: center;
}
.apidoc-badge-get    { background: rgba(16,185,129,.2); color: #34d399; }
.apidoc-badge-post   { background: rgba(59,130,246,.2); color: #60a5fa; }
.apidoc-badge-delete { background: rgba(239,68,68,.2);  color: #f87171; }
.apidoc-badge-put    { background: rgba(245,158,11,.2); color: #fbbf24; }

/* ── Main ───────────────────────────────────────────────────────────────────── */
.apidoc-main {
    padding: 2rem 2.5rem;
    max-width: 900px;
    overflow: hidden;
}

/* ── Section headers ────────────────────────────────────────────────────────── */
.apidoc-section { margin-bottom: 2.5rem; }
.apidoc-h1 {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -.02em;
    display: flex;
    align-items: center;
    gap: .75rem;
    flex-wrap: wrap;
    margin-bottom: .5rem;
}
.apidoc-h2 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: .75rem;
    padding-bottom: .5rem;
    border-bottom: 1px solid var(--border);
}
.apidoc-desc { color: var(--text-muted); font-size: .9rem; line-height: 1.7; }

.apidoc-version-badge {
    font-size: .75rem;
    font-family: var(--font-mono);
    background: rgba(59,130,246,.12);
    border: 1px solid rgba(59,130,246,.3);
    color: #93c5fd;
    padding: .2rem .65rem;
    border-radius: 999px;
    font-weight: 600;
}

.apidoc-tag {
    font-size: .72rem;
    font-weight: 600;
    padding: .2rem .65rem;
    border-radius: 999px;
}
.apidoc-tag.green  { background: rgba(16,185,129,.12); color: #34d399; border: 1px solid rgba(16,185,129,.2); }
.apidoc-tag.blue   { background: rgba(59,130,246,.12); color: #60a5fa; border: 1px solid rgba(59,130,246,.2); }
.apidoc-tag.purple { background: rgba(139,92,246,.12); color: #a78bfa; border: 1px solid rgba(139,92,246,.2); }

/* ── URL box ────────────────────────────────────────────────────────────────── */
.apidoc-url-box {
    display: flex;
    align-items: center;
    gap: .75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .7rem 1rem;
    font-family: var(--font-mono);
}
.apidoc-url-scheme {
    font-size: .72rem;
    font-weight: 700;
    background: rgba(16,185,129,.15);
    color: #34d399;
    padding: .15rem .5rem;
    border-radius: 4px;
    border: 1px solid rgba(16,185,129,.2);
}
.apidoc-url-text { font-size: .85rem; color: var(--text); flex: 1; }

.apidoc-copy-btn {
    background: none;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--text-muted);
    cursor: pointer;
    padding: .3rem .4rem;
    transition: all .15s;
    display: flex;
    align-items: center;
}
.apidoc-copy-btn:hover { border-color: var(--primary); color: var(--primary); }
.apidoc-copy-btn.copied { border-color: var(--success); color: var(--success); }

/* ── Code block ─────────────────────────────────────────────────────────────── */
.apidoc-code {
    background: #070a12;
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    font-family: var(--font-mono);
    font-size: .8rem;
    color: #7dd3a8;
    line-height: 1.75;
    white-space: pre-wrap;
    margin-bottom: .75rem;
}
[data-theme="light"] .apidoc-code { background: #1e293b; }

/* ── Callout ────────────────────────────────────────────────────────────────── */
.apidoc-callout {
    padding: .75rem 1rem;
    border-radius: 8px;
    font-size: .85rem;
    line-height: 1.6;
    border-left: 3px solid;
}
.apidoc-callout-warning {
    background: rgba(245,158,11,.08);
    border-left-color: var(--warning);
    color: var(--text-dim);
}
.apidoc-callout-info {
    background: rgba(59,130,246,.08);
    border-left-color: var(--primary);
    color: var(--text-dim);
}

/* ── Endpoint group ─────────────────────────────────────────────────────────── */
.apidoc-group { margin-bottom: 2.5rem; }
.apidoc-group-header {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-bottom: 1rem;
    padding-bottom: .6rem;
    border-bottom: 1px solid var(--border);
}
.apidoc-group-title {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text);
}
.apidoc-group-count {
    font-size: .72rem;
    color: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: .1rem .5rem;
    border-radius: 999px;
}

/* ── Endpoint card ──────────────────────────────────────────────────────────── */
.apidoc-endpoint {
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: .5rem;
    overflow: hidden;
    transition: border-color .15s;
}
.apidoc-endpoint:hover { border-color: rgba(59,130,246,.3); }

.apidoc-ep-header {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .75rem 1rem;
    cursor: pointer;
    background: var(--bg-card);
    transition: background .15s;
    flex-wrap: wrap;
    user-select: none;
}
.apidoc-ep-header:hover { background: var(--bg-elevated); }
.apidoc-ep-header.open { background: var(--bg-elevated); }

.apidoc-method {
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 800;
    padding: .25rem .65rem;
    border-radius: 5px;
    border: 1px solid;
    min-width: 62px;
    text-align: center;
    letter-spacing: .04em;
    flex-shrink: 0;
}
.apidoc-method-get    { background: rgba(16,185,129,.12); color: #34d399; border-color: rgba(16,185,129,.25); }
.apidoc-method-post   { background: rgba(59,130,246,.12); color: #60a5fa; border-color: rgba(59,130,246,.25); }
.apidoc-method-delete { background: rgba(239,68,68,.12);  color: #f87171; border-color: rgba(239,68,68,.25); }
.apidoc-method-put    { background: rgba(245,158,11,.12); color: #fbbf24; border-color: rgba(245,158,11,.25); }

.apidoc-path {
    font-family: var(--font-mono);
    font-size: .82rem;
    color: var(--text);
    flex-shrink: 0;
}
.apidoc-summary {
    font-size: .85rem;
    color: var(--text-muted);
    flex: 1;
}
.apidoc-ep-meta { display: flex; gap: .4rem; align-items: center; }

.apidoc-auth-badge {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .72rem;
    font-weight: 600;
    color: #fbbf24;
    background: rgba(245,158,11,.1);
    border: 1px solid rgba(245,158,11,.2);
    padding: .18rem .55rem;
    border-radius: 999px;
}
.apidoc-public-badge {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .72rem;
    font-weight: 600;
    color: #34d399;
    background: rgba(16,185,129,.1);
    border: 1px solid rgba(16,185,129,.2);
    padding: .18rem .55rem;
    border-radius: 999px;

.apidoc-chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform .2s ease;
    margin-left: auto;
}
.apidoc-chevron.open { transform: rotate(180deg); }

/* ── Panel ──────────────────────────────────────────────────────────────────── */
.apidoc-ep-panel {
    display: none;
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
}
.apidoc-ep-panel.open { display: block; animation: fadeInPanel .2s ease; }

@@keyframes fadeInPanel {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
}

.apidoc-ep-body { padding: 1.25rem 1.25rem 1.5rem; }

/* ── Try it section ─────────────────────────────────────────────────────────── */
.apidoc-try-section {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
}
.apidoc-try-header {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    font-size: .8rem;
    font-weight: 600;
    color: var(--primary);
    letter-spacing: .03em;
}
.apidoc-try-body { padding: 1rem; display: flex; flex-direction: column; gap: .85rem; }

.apidoc-try-row { display: grid; grid-template-columns: 90px 1fr; gap: .75rem; align-items: center; }
.apidoc-try-label {
    font-size: .72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--text-muted);
}

.apidoc-try-url-bar {
    display: flex;
    align-items: center;
    gap: .5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: .4rem .75rem;
    font-family: var(--font-mono);
}
.apidoc-method-mini {
    font-family: var(--font-mono);
    font-size: .65rem;
    font-weight: 800;
    padding: .1rem .35rem;
    border-radius: 3px;
    letter-spacing: .04em;
}
.apidoc-try-url-text {
    font-size: .78rem;
    color: var(--text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.apidoc-try-input {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: .8rem;
    padding: .5rem .75rem;
    width: 100%;
    transition: border-color .15s, box-shadow .15s;
}
.apidoc-try-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-glow);
}
.apidoc-try-input::placeholder { color: var(--text-muted); }

.apidoc-try-textarea {
    background: #070a12;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: #86efac;
    font-family: var(--font-mono);
    font-size: .78rem;
    padding: .6rem .75rem;
    width: 100%;
    resize: vertical;
    line-height: 1.65;
    transition: border-color .15s;
}
.apidoc-try-textarea:focus { outline: none; border-color: var(--primary); }
[data-theme="light"] .apidoc-try-textarea { background: #1e293b; }

.apidoc-try-actions {
    display: flex;
    gap: .5rem;
    align-items: center;
    padding-top: .25rem;
    border-top: 1px solid var(--border);
}

.apidoc-exec-btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    background: var(--primary);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: .55rem 1.25rem;
    font-size: .82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all .15s;
}
.apidoc-exec-btn:hover { background: var(--primary-dark); transform: translateY(-1px); }
.apidoc-exec-btn:disabled { opacity: .6; cursor: wait; transform: none; }

.apidoc-clear-btn {
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-muted);
    cursor: pointer;
    font-size: .78rem;
    padding: .5rem .85rem;
    transition: all .15s;
}
.apidoc-clear-btn:hover { border-color: var(--primary); color: var(--primary); }

/* ── Response ───────────────────────────────────────────────────────────────── */
.apidoc-response {
    margin-top: .85rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    animation: fadeInPanel .2s ease;
}
.apidoc-res-header {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .5rem .75rem;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
}
.apidoc-res-title {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--text-muted);
}
.apidoc-res-status {
    font-family: var(--font-mono);
    font-size: .78rem;
    font-weight: 700;
    padding: .1rem .5rem;
    border-radius: 4px;
}
.apidoc-res-status.ok     { background: rgba(16,185,129,.15); color: #34d399; }
.apidoc-res-status.err    { background: rgba(239,68,68,.15);  color: #f87171; }
.apidoc-res-status.warn   { background: rgba(245,158,11,.15); color: #fbbf24; }
.apidoc-res-time {
    font-size: .72rem;
    color: var(--text-muted);
    margin-right: auto;
}
.apidoc-res-body {
    background: #070a12;
    color: #86efac;
    font-family: var(--font-mono);
    font-size: .78rem;
    line-height: 1.7;
    padding: 1rem;
    margin: 0;
    max-height: 360px;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-all;
}
[data-theme="light"] .apidoc-res-body { background: #1e293b; }

/* ── Responsive ─────────────────────────────────────────────────────────────── */
@@media (max-width: 900px) {
    .apidoc-wrap { grid-template-columns: 1fr; }
    .apidoc-sidebar { display: none; }
    .apidoc-main { padding: 1.5rem 1rem; max-width: 100%; }
    .apidoc-try-row { grid-template-columns: 1fr; }
    .apidoc-try-label { display: none; }
    .apidoc-h1 { font-size: 1.4rem; }
}
@@media (max-width: 640px) {
    .apidoc-ep-header { flex-wrap: wrap; gap: .5rem; }
    .apidoc-summary { width: 100%; order: 5; }
}
</style>

<script>
// ── Toggle endpoint panel ─────────────────────────────────────────────────────
function togglePanel(panelId, header) {
    const panel   = document.getElementById(panelId);
    const chevron = header.querySelector('.apidoc-chevron');
    if (!panel) return;
    const isOpen = panel.classList.toggle('open');
    header.classList.toggle('open', isOpen);
    if (chevron) chevron.classList.toggle('open', isOpen);

    if (isOpen) {
        // Highlight active sidebar link
        document.querySelectorAll('.apidoc-sidebar-link').forEach(l => l.classList.remove('active'));
        const ep = panel.closest('.apidoc-endpoint');
        if (ep?.id) {
            const link = document.querySelector(`.apidoc-sidebar-link[href="#${ep.id}"]`);
            link?.classList.add('active');
        }
    }
}

// ── Update path param URL preview ─────────────────────────────────────────────
function updateUrl(input) {
    const baseUrlTpl = input.dataset.baseUrl;
    const targetId   = input.dataset.urlTarget;
    const target     = document.getElementById(targetId);
    if (!target) return;
    const val = input.value.trim();
    if (!val) { target.textContent = baseUrlTpl; return; }
    // Replace first {param} with the typed value
    target.textContent = baseUrlTpl.replace(/\{[^}]+\}/, val);
}

// ── Execute request ───────────────────────────────────────────────────────────
async function executeRequest(panelId, method, urlBase, requiresAuth, hasBody) {
    const btn      = document.querySelector(`#res-${panelId}`)?.closest('.apidoc-try-section')?.querySelector('.apidoc-exec-btn');
    const resEl    = document.getElementById(`res-${panelId}`);
    const resData  = document.getElementById(`resdata-${panelId}`);
    const statusEl = document.getElementById(`status-${panelId}`);
    const timeEl   = document.getElementById(`time-${panelId}`);
    const tokenIn  = document.getElementById(`token-${panelId}`);
    const bodyIn   = document.getElementById(`body-${panelId}`);
    const urlPrev  = document.getElementById(`url-${panelId}`);

    if (!resEl) return;
    resEl.style.display = 'block';
    resData.textContent = 'Enviando…';
    statusEl.textContent = '';
    statusEl.className = 'apidoc-res-status';
    if (btn) { btn.disabled = true; btn.textContent = 'Enviando…'; }

    const url = urlPrev ? urlPrev.textContent : urlBase;
    const headers = { 'Content-Type': 'application/json' };
    if (requiresAuth && tokenIn?.value) {
        headers['Authorization'] = 'Bearer ' + tokenIn.value.trim();
    }

    const start = Date.now();
    try {
        const opts = { method, headers };
        if (hasBody && bodyIn?.value) {
            opts.body = bodyIn.value;
        }
        const res = await fetch(url, opts);
        const elapsed = Date.now() - start;
        const text = await res.text();

        let formatted;
        try { formatted = JSON.stringify(JSON.parse(text), null, 2); }
        catch { formatted = text || '(sin cuerpo de respuesta)'; }

        resData.textContent = formatted;
        resData.style.color = res.ok ? '#86efac' : '#f87171';
        statusEl.textContent = `${res.status} ${res.statusText}`;
        statusEl.className = 'apidoc-res-status ' + (res.ok ? 'ok' : res.status < 500 ? 'warn' : 'err');
        if (timeEl) timeEl.textContent = `${elapsed}ms`;

    } catch (err) {
        resData.textContent = `Error de red: ${err.message}\n\nAsegúrate de que el servidor esté corriendo.`;
        resData.style.color = '#f87171';
        statusEl.textContent = 'Error';
        statusEl.className = 'apidoc-res-status err';
    } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/></svg> Ejecutar'; }
    }
}

// ── Clear response ────────────────────────────────────────────────────────────
function clearResponse(panelId) {
    const resEl = document.getElementById(`res-${panelId}`);
    if (resEl) resEl.style.display = 'none';
}

// ── Copy helpers ──────────────────────────────────────────────────────────────
function copyText(text, btn) {
    navigator.clipboard.writeText(text).then(() => {
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1500);
    });
}

function copyResponse(panelId) {
    const text = document.getElementById(`resdata-${panelId}`)?.textContent;
    if (text) navigator.clipboard.writeText(text);
}

// ── Sidebar scroll spy ────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function () {
    const links   = document.querySelectorAll('.apidoc-sidebar-link[href^="#"]');
    const observe = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (e.isIntersecting) {
                links.forEach(l => l.classList.remove('active'));
                const link = document.querySelector(`.apidoc-sidebar-link[href="#${e.target.id}"]`);
                link?.classList.add('active');
            }
        });
    }, { rootMargin: '-64px 0px -60% 0px' });

    document.querySelectorAll('.apidoc-group, .apidoc-section').forEach(s => observe.observe(s));
});
</script>
}

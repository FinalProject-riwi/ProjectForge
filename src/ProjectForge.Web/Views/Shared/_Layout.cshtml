<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TabBuilder — Genera proyectos de software listos para producción con IA y GitHub." />
    <title>@ViewData["Title"] – TabBuilder</title>

    <!-- PWA / Installable -->
    <meta name="application-name" content="TabBuilder" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TabBuilder" />
    <meta name="theme-color" content="#0a0d14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f1f5fb" media="(prefers-color-scheme: light)" />

    <link rel="icon" type="image/jpeg" href="~/img/logo.jpg" />
    <link rel="apple-touch-icon" href="~/img/logo.jpg" />

    <!-- Manifest para instalación como app de escritorio / móvil -->
    <link rel="manifest" href="~/manifest.json" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />

    <!-- SignalR (local copy — CDN is unreliable in some environments) -->
    <script src="~/js/signalr.min.js" asp-append-version="true" defer></script>

    <!-- Tema: cargar antes de paint para evitar flash -->
    <script>
        (function () {
            const saved = localStorage.getItem('pf-theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = saved ?? (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
    <!-- ── Page background (grid + glow + particles), spans the whole page ─── -->
    <div class="page-bg" aria-hidden="true">
        <div class="hero-grid"></div>
        <div class="hero-particles" id="hero-particles"></div>
    </div>

    <!-- ── Navbar ──────────────────────────────────────────────────────────── -->
    <nav class="navbar" role="navigation" aria-label="Navegación principal">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="TabBuilder inicio">
            <img src="~/img/logo.jpg" alt="TabBuilder" class="brand-logo" />
            <span>Tab<strong>Builder</strong></span>
        </a>

        <button class="navbar-toggle" id="navbar-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="navbar-links">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="navbar-links" id="navbar-links">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a href="/api-docs" class="api-link">API</a>
                <a href="/download" style="color:var(--text-dim)">Descargar app</a>
                <a asp-controller="Wizard" asp-action="Index" class="btn btn-primary btn-sm">+ Nuevo Proyecto</a>

                <button class="theme-toggle" id="theme-toggle-btn" title="Cambiar tema" aria-label="Cambiar tema claro/oscuro">🌙</button>

                <div class="user-menu">
                    @{
                        var avatarUrl = User.FindFirst("avatar_url")?.Value;
                        var userName  = User.Identity?.Name ?? "?";
                        var userInit  = userName.Length > 0 ? userName[0].ToString().ToUpper() : "?";
                    }
                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="avatar" class="avatar"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                        <div class="avatar avatar-fallback" style="display:none">@userInit</div>
                    }
                    else
                    {
                        <div class="avatar avatar-fallback">@userInit</div>
                    }
                    <span style="font-size:.85rem;color:var(--text-dim)">@userName</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost btn-sm">Salir</button>
                    </form>
                </div>
            }
            else
            {
                <a href="/api-docs" class="api-link" style="color:var(--text-dim)">API</a>
                <a href="/download" style="color:var(--text-dim)">Descargar</a>
                <button class="theme-toggle" id="theme-toggle-btn" title="Cambiar tema" aria-label="Cambiar tema claro/oscuro">🌙</button>
                <a asp-controller="Auth" asp-action="GitHubLogin" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                    Conectar con GitHub
                </a>
            }
        </div>
    </nav>

    <!-- ── WIP Modal ───────────────────────────────────────────────────────── -->
    <div id="wip-modal" class="wip-modal-backdrop" style="display:none" role="dialog" aria-modal="true" aria-labelledby="wip-modal-title">
        <div class="wip-modal">
            <div class="wip-modal-icon">🚧</div>
            <h2 id="wip-modal-title">En implementación</h2>
            <p id="wip-modal-msg">Esta funcionalidad está siendo desarrollada y estará disponible próximamente.</p>
            <button class="btn btn-primary" onclick="document.getElementById('wip-modal').style.display='none'">Entendido</button>
        </div>
    </div>

    <!-- ── Main ────────────────────────────────────────────────────────────── -->
    <main class="@(ViewData["FullWidth"] != null ? "main-content-full" : "main-content")" id="main-content">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error" id="global-error-alert" role="alert">
                <span>@TempData["Error"]</span>
                <button onclick="this.parentElement.remove()" aria-label="Cerrar">✕</button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="alert">
                <span>@TempData["Success"]</span>
                <button onclick="this.parentElement.remove()" aria-label="Cerrar">✕</button>
            </div>
        }
        @RenderBody()
    </main>

    <!-- ── Footer ──────────────────────────────────────────────────────────── -->
    <footer class="footer">
        <div style="display:flex;align-items:center;justify-content:center;gap:.5rem;margin-bottom:.75rem">
            <img src="~/img/logo.jpg" alt="" style="width:20px;height:20px;border-radius:5px;opacity:.6" />
            <span style="font-family:var(--font-mono);color:var(--text-dim)">TabBuilder</span>
        </div>
        <p style="margin-bottom:.6rem">Genera proyectos de software listos para producción — impulsado por IA</p>
        <div style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-bottom:.6rem">
            <a href="/download">Descargar app</a>
            <a href="/privacy">Privacidad</a>
            <a href="/terms">Términos</a>
            <a href="/api-docs">API</a>
        </div>
        <p>&copy; @DateTime.Now.Year TabBuilder. Todos los derechos reservados.</p>
    </footer>

    <!-- ── Scripts ─────────────────────────────────────────────────────────── -->
    <script>
    // ── Tema claro/oscuro ─────────────────────────────────────────────────────
    (function () {
        const STORAGE_KEY = 'pf-theme';
        const html = document.documentElement;

        function updateToggle(theme) {
            const btn = document.getElementById('theme-toggle-btn');
            if (!btn) return;
            btn.textContent = theme === 'dark' ? '🌙' : '☀️';
            btn.title = theme === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro';
            btn.setAttribute('aria-label', btn.title);
        }

        const current = html.getAttribute('data-theme') || 'dark';
        updateToggle(current);

        document.addEventListener('DOMContentLoaded', function () {
            updateToggle(html.getAttribute('data-theme') || 'dark');
            const btn = document.getElementById('theme-toggle-btn');
            if (btn) {
                btn.addEventListener('click', function () {
                    const cur  = html.getAttribute('data-theme') || 'dark';
                    const next = cur === 'dark' ? 'light' : 'dark';
                    html.setAttribute('data-theme', next);
                    localStorage.setItem(STORAGE_KEY, next);
                    updateToggle(next);
                    // Update meta theme-color
                    const metaColor = document.querySelector('meta[name="theme-color"]');
                    if (metaColor) metaColor.content = next === 'dark' ? '#0a0d14' : '#f1f5fb';
                });
            }

            // ── Responsive navbar ─────────────────────────────────────────────
            const toggle = document.getElementById('navbar-toggle');
            const links  = document.getElementById('navbar-links');
            if (toggle && links) {
                toggle.addEventListener('click', function () {
                    const open = links.classList.toggle('open');
                    toggle.setAttribute('aria-expanded', open);
                });
                // Close on outside click
                document.addEventListener('click', function (e) {
                    if (!toggle.contains(e.target) && !links.contains(e.target)) {
                        links.classList.remove('open');
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            // ── Scroll reveal ─────────────────────────────────────────────────
            const observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: .12 });

            document.querySelectorAll('.reveal').forEach(function (el) {
                observer.observe(el);
            });

            // ── Page background — floating code particles ──────────────────────
            // Lives in the layout so the backdrop is consistent across every
            // page, not just the landing hero.
            const particleHost = document.getElementById('hero-particles');
            if (particleHost) {
                const snippets = [
                    'dotnet new webapi', 'git init', 'docker-compose up',
                    'npm install', 'pip install fastapi', 'composer create-project',
                    'kubectl apply -f', 'mvn spring-boot:run', 'go mod init',
                    'SELECT * FROM', 'async/await', 'IRepository<T>', 'Clean Architecture',
                    '{ "name": "app" }', 'FROM node:20', 'services:', 'ENTRYPOINT',
                    'github.com/actions', 'Bearer ${token}', 'swagger.json',
                ];
                const count = window.innerWidth < 640 ? 10 : 20;
                for (let i = 0; i < count; i++) {
                    const el = document.createElement('span');
                    el.className = 'hero-particle';
                    el.textContent = snippets[i % snippets.length];
                    el.style.left = (Math.random() * 100) + '%';
                    el.style.animationDuration = (22 + Math.random() * 26) + 's';
                    el.style.animationDelay = (-Math.random() * 40) + 's';
                    el.style.fontSize = (.62 + Math.random() * .2) + 'rem';
                    el.style.opacity = (.1 + Math.random() * .15).toString();
                    particleHost.appendChild(el);
                }
            }

            // ── Auto-dismiss alerts ───────────────────────────────────────────
            document.querySelectorAll('.alert').forEach(function (el) {
                setTimeout(function () {
                    el.style.opacity = '0';
                    el.style.transition = 'opacity .4s';
                    setTimeout(function () { el.remove(); }, 400);
                }, 6000);
            });
        });
    })();

    // ── WIP Modal ─────────────────────────────────────────────────────────────
    function showWipModal(msg) {
        const modal = document.getElementById('wip-modal');
        const msgEl = document.getElementById('wip-modal-msg');
        if (msgEl && msg) msgEl.textContent = msg;
        if (modal) {
            modal.style.display = 'flex';
            modal.querySelector('button')?.focus();
        }
    }
    function closeWipModal(e) {
        if (e.target === document.getElementById('wip-modal')) {
            document.getElementById('wip-modal').style.display = 'none';
        }
    }
    document.getElementById('wip-modal')?.addEventListener('click', closeWipModal);

    // Close modal on Escape
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            document.getElementById('wip-modal').style.display = 'none';
        }
    });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @* Voice assistant — only for authenticated users *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/voice.js" asp-append-version="true" defer></script>
    }
</body>
</html>

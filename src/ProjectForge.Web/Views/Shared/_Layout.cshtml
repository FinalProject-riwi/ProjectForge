<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – TabBuilder</title>
    <link rel="icon" type="image/jpeg" href="~/img/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <!-- SignalR cargado en <head> para garantizar disponibilidad antes de cualquier script de página -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
</head>
<body>
    <nav class="navbar">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <img src="~/img/logo.jpg" alt="TabBuilder" class="brand-logo" />
            <span>Tab<strong>Builder</strong></span>
        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="navbar-links">
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a href="/api-docs" class="api-link">API</a>
                <a asp-controller="Wizard" asp-action="Index" class="btn btn-primary">+ Nuevo Proyecto</a>
                <button class="theme-toggle" id="theme-toggle-btn" title="Cambiar tema" aria-label="Cambiar tema claro/oscuro">🌙</button>
                <div class="user-menu">
                    @{
                        var avatarUrl = User.FindFirst("avatar_url")?.Value;
                        var userName = User.Identity?.Name ?? "?";
                        var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "?";
                    }
                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                    {
                        <img src="@avatarUrl"
                             alt="avatar"
                             class="avatar"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="avatar avatar-fallback" style="display:none">@userInitial</div>
                    }
                    else
                    {
                        <div class="avatar avatar-fallback">@userInitial</div>
                    }
                    <span>@userName</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost btn-sm">Salir</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div style="display:flex;align-items:center;gap:.75rem;">
                <button class="theme-toggle" id="theme-toggle-btn" title="Cambiar tema" aria-label="Cambiar tema claro/oscuro">🌙</button>
                <a asp-controller="Auth" asp-action="GitHubLogin" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    Conectar con GitHub
                </a>
            </div>
        }
    </nav>

    <!-- Global "En implementación" Modal -->
    <div id="wip-modal" class="wip-modal-backdrop" style="display:none" onclick="closeWipModal(event)">
        <div class="wip-modal">
            <div class="wip-modal-icon">🚧</div>
            <h2>En implementación</h2>
            <p id="wip-modal-msg">Esta funcionalidad está siendo desarrollada y estará disponible próximamente.</p>
            <button class="btn btn-primary" onclick="document.getElementById('wip-modal').style.display='none'">Entendido</button>
        </div>
    </div>

    <main class="main-content">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error" id="global-error-alert">
                <span>⚠️ @TempData["Error"]</span>
                <button onclick="this.parentElement.remove()">✕</button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        <p>TabBuilder &copy; @DateTime.Now.Year — Genera proyectos completos con IA</p>
    </footer>

    <script>
    // ── Tema claro/oscuro ────────────────────────────────────────────────────
    (function () {
        const STORAGE_KEY = 'pf-theme';
        const html = document.documentElement;
        const saved = localStorage.getItem(STORAGE_KEY);
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const initial = saved ?? (prefersDark ? 'dark' : 'light');
        html.setAttribute('data-theme', initial);

        function updateToggleIcon(theme) {
            const btn = document.getElementById('theme-toggle-btn');
            if (!btn) return;
            btn.textContent = theme === 'dark' ? '🌙' : '☀️';
            btn.title = theme === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro';
        }
        updateToggleIcon(initial);

        document.addEventListener('DOMContentLoaded', function () {
            updateToggleIcon(html.getAttribute('data-theme') || 'dark');
            const btn = document.getElementById('theme-toggle-btn');
            if (!btn) return;
            btn.addEventListener('click', function () {
                const current = html.getAttribute('data-theme') || 'dark';
                const next = current === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', next);
                localStorage.setItem(STORAGE_KEY, next);
                updateToggleIcon(next);
            });
        });
    })();

    // ── WIP Modal ────────────────────────────────────────────────────────────
    function showWipModal(msg) {
        const modal = document.getElementById('wip-modal');
        const msgEl = document.getElementById('wip-modal-msg');
        if (msgEl && msg) msgEl.textContent = msg;
        if (modal) modal.style.display = 'flex';
    }
    function closeWipModal(e) {
        if (e.target === document.getElementById('wip-modal')) {
            document.getElementById('wip-modal').style.display = 'none';
        }
    }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – ProjectForge</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <!-- SignalR cargado en <head> para garantizar disponibilidad antes de cualquier script de página -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
</head>
<body>
    <nav class="navbar">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-icon">⚙</span>
            <span>Project<strong>Forge</strong></span>
        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="navbar-links">
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-controller="Wizard" asp-action="Index" class="btn btn-primary">+ Nuevo Proyecto</a>
                <div class="user-menu">
                    @{
                        var avatarUrl = User.FindFirst("avatar_url")?.Value;
                        var userName = User.Identity?.Name ?? "?";
                        var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "?";
                    }
                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                    {
                        <img src="@avatarUrl"
                             alt="avatar"
                             class="avatar"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="avatar avatar-fallback" style="display:none">@userInitial</div>
                    }
                    else
                    {
                        <div class="avatar avatar-fallback">@userInitial</div>
                    }
                    <span>@User.Identity.Name</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost btn-sm">Salir</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <a asp-controller="Auth" asp-action="GitHubLogin" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                Conectar con GitHub
            </a>
        }
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>ProjectForge &copy; @DateTime.Now.Year — Genera proyectos completos con IA</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

        <script>
        function toggleChatbot() {
            const panel = document.getElementById('chatbot-panel');
            const open = panel.style.display !== 'none';
            panel.style.display = open ? 'none' : 'flex';
            if (!open) document.getElementById('chatbot-input').focus();
        }

        let chatHistory = [];

        async function sendChat() {
            const input = document.getElementById('chatbot-input');
            const msg = input.value.trim();
            if (!msg) return;

            const msgs = document.getElementById('chatbot-messages');
            const btn = document.getElementById('chatbot-send-btn');

            // Show user message
            msgs.innerHTML += `<div class="chat-msg user">${escapeHtml(msg)}</div>`;
            input.value = '';
            btn.disabled = true;

            // Typing indicator
            const typing = document.createElement('div');
            typing.className = 'chat-msg bot typing';
            typing.id = 'typing-indicator';
            typing.textContent = 'Escribiendo...';
            msgs.appendChild(typing);
            msgs.scrollTop = msgs.scrollHeight;

            // Build context from current wizard state if available
            const wizardCtx = typeof state !== 'undefined'
                ? `Contexto del wizard: arquitectura=${state.architecture||'?'}, framework=${state.framework||'?'}, db=${state.database||'?'}, infraestructura=${state.infrastructure||'?'}.\n\n`
                : '';

            chatHistory.push({ role: 'user', content: wizardCtx + msg });

            try {
                const resp = await fetch('/wizard/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messages: chatHistory })
                });

                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                const data = await resp.json();
                const reply = data.reply || 'Sin respuesta.';
                chatHistory.push({ role: 'assistant', content: reply });

                typing.remove();
                msgs.innerHTML += `<div class="chat-msg bot">${escapeHtml(reply)}</div>`;
            } catch (e) {
                typing.remove();
                msgs.innerHTML += `<div class="chat-msg bot" style="color:#f87171">Error al conectar con la IA. Intenta de nuevo.</div>`;
            }

            btn.disabled = false;
            msgs.scrollTop = msgs.scrollHeight;
        }

        function escapeHtml(t) {
            return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
        </script>
    }



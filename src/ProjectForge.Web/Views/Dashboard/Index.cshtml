@using ProjectForge.Core.Entities
@using ProjectForge.Core.Enums
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model IEnumerable<Project>
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
    var githubName = User.Identity?.Name ?? "amigo";
    var agentId = Configuration["ElevenLabs:AgentId"] ?? "";
}

<!-- Voice card: greets user, ElevenLabs agent handles the conversation -->
<div class="dashboard-voice-card">
    <div class="dashboard-voice-icon">🤖</div>
    <div class="dashboard-voice-body">
        <strong>Hola, @githubName! ¿Qué construimos hoy?</strong>
        <p>Presiona el micrófono de abajo a la derecha y cuéntame tu stack, con calma.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(agentId))
{
    <!-- ElevenLabs conversational agent — handles STT + understanding + TTS end-to-end -->
    <elevenlabs-convai agent-id="@agentId" id="pf-voice-agent"></elevenlabs-convai>
    <script src="https://unpkg.com/@@elevenlabs/convai-widget-embed" async type="text/javascript"></script>
    <script src="~/js/voice-agent.js" asp-append-version="true" defer></script>
}

<div class="dashboard-header">
    <div>
        <p class="section-eyebrow" style="text-align:left;margin-bottom:.3rem">Mis Proyectos</p>
        <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-.02em">
            @Model.Count() proyecto(s) generado(s)
        </h1>
    </div>
    <a asp-controller="Wizard" asp-action="Index" class="btn btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        Nuevo Proyecto
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">🔧</div>
        <h2>Aún no tienes proyectos</h2>
        <p>Usa el wizard para generar tu primer proyecto en minutos.</p>
        <a asp-controller="Wizard" asp-action="Index" class="btn btn-primary mt-4">Crear primer proyecto</a>
    </div>
}
else
{
    <div class="dashboard-grid">
        @foreach (var project in Model)
        {
            <div class="project-card">
                <div class="project-card-header">
                    <div style="min-width:0">
                        <h3 class="project-name">@project.Name</h3>
                        <span class="project-status status-@project.Status.ToString().ToLower()">
                            @project.Status
                        </span>
                    </div>
                    <div class="project-arch-badge">
                        @{ var logo = GetArchLogo(project.WizardConfig?.Architecture); }
                        @if (!string.IsNullOrEmpty(logo))
                        {
                            <img src="@logo" alt="arch" style="width:26px;height:26px;object-fit:contain" />
                        }
                        else
                        {
                            <span style="font-size:1.2rem">📦</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(project.Description))
                {
                    <p class="project-desc">@project.Description</p>
                }

                <div class="project-meta">
                    <span>📅 @project.CreatedAt.ToString("dd MMM yyyy")</span>
                    @if (project.WizardConfig != null)
                    {
                        <span>⚙ @project.WizardConfig.Framework</span>
                        <span>🗄 @project.WizardConfig.Database</span>
                    }
                </div>

                <div class="project-actions">
                    <a asp-controller="Projects" asp-action="Detail" asp-route-id="@project.Id"
                       class="btn btn-ghost btn-sm">Ver detalles</a>

                    @if (!string.IsNullOrEmpty(project.RepositoryUrl))
                    {
                        <a href="@project.RepositoryUrl" target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                            GitHub →
                        </a>
                    }

                    @if (project.Status == ProjectStatus.Draft || project.Status == ProjectStatus.Failed)
                    {
                        <a asp-controller="Wizard" asp-action="Generate" asp-route-id="@project.Id"
                           class="btn btn-primary btn-sm">Generar</a>
                    }
                </div>
            </div>
        }
    </div>
}

@functions {
    string GetArchLogo(ArchitectureType? arch) => arch switch
    {
        ArchitectureType.DotNet       => "/img/logos/languages/csharp.png",
        ArchitectureType.Python       => "/img/logos/languages/python.png",
        ArchitectureType.Java         => "/img/logos/languages/java.png",
        ArchitectureType.JavaScript   => "/img/logos/languages/javascript.png",
        ArchitectureType.TypeScript   => "/img/logos/languages/typescript.png",
        ArchitectureType.Php          => "/img/logos/languages/php.png",
        _                             => ""
    };
}

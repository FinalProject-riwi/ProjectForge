@{
    ViewData["Title"] = "Nuevo Proyecto";
    Layout = "_Layout";
}

<!-- Voice assistant init marker -->
<div id="voice-wizard-init" style="display:none"></div>

<button type="button" id="wizard-voice-activate" class="btn btn-ghost"
        style="margin-bottom:1rem;border-color:rgba(34,211,238,.35);color:#22d3ee"
        onclick="window.__voiceWizardActivate?.(); this.textContent='🔊 Voz activada'; this.disabled=true;">
    🔊 Activar narración por voz
</button>

<div class="wizard-container">
    <!-- Progress Bar -->
    <div class="wizard-progress">
        <div class="progress-steps">
            @foreach (var (label, i) in new[] { "Arquitectura", "Framework & BD", "Infraestructura", "Patrones & Libs", "Confirmar" }.Select((l, i) => (l, i + 1)))
            {
                <div class="progress-step" id="step-indicator-@i" data-step="@i">
                    <div class="step-circle">@i</div>
                    <span class="step-label">@label</span>
                </div>
            }
        </div>
        <div class="progress-bar-track">
            <div class="progress-bar-fill" id="progress-fill" style="width: 20%"></div>
        </div>
    </div>

    <form id="wizard-form">
        @Html.AntiForgeryToken()

        <!-- ── Step 1: Arquitectura ──────────────────────────────────────── -->
        <div class="wizard-step active" data-step="1">
            <h2>¿Qué arquitectura usará tu proyecto?</h2>
            <p class="step-description">Selecciona el lenguaje base de tu aplicación</p>
            <p class="step-voice-hint">Di: "Python", "Java", "C Sharp", "PHP", "JavaScript" o "TypeScript"</p>

            <div class="arch-grid">
                @foreach (var arch in new[] {
                    ("DotNet",     "C# / .NET",   "/img/logos/languages/csharp.png",     "ASP.NET Core, Blazor, Minimal API"),
                    ("Java",       "Java",         "/img/logos/languages/java.png",        "Spring Boot, Quarkus, Micronaut"),
                    ("Python",     "Python",       "/img/logos/languages/python.png",      "FastAPI, Django, Flask"),
                    ("Php",        "PHP",          "/img/logos/languages/php.png",         "Laravel, Symfony"),
                    ("JavaScript", "JavaScript",   "/img/logos/languages/javascript.png",  "Node.js, Express, NestJS, Next.js"),
                    ("TypeScript", "TypeScript",   "/img/logos/languages/typescript.png",  "NestTS, Next.js (TS)")
                })
                {
                    <label class="arch-card" data-value="@arch.Item1">
                        <input type="radio" name="architecture" value="@arch.Item1" />
                        <img src="@arch.Item3" alt="@arch.Item2" class="arch-logo" onerror="this.style.display='none'" />
                        <span class="arch-name">@arch.Item2</span>
                        <span class="arch-desc">@arch.Item4</span>
                    </label>
                }
            </div>
        </div>

        <!-- ── Step 2: Framework & BD ────────────────────────────────────── -->
        <div class="wizard-step" data-step="2">
            <h2>Framework y Base de Datos</h2>
            <p class="step-voice-hint">Di: "FastAPI con PostgreSQL", "Spring Boot y MySQL", etc.</p>

            <div class="form-section">
                <label>Framework</label>
                <div id="framework-options" class="option-grid">
                    <!-- Cargado dinámicamente por JS -->
                </div>

                <label class="mt-4">Versión</label>
                <select name="frameworkVersion" id="framework-version-select" class="form-select">
                    <option value="">Selecciona un framework primero</option>
                </select>
            </div>

            <div class="form-section mt-6">
                <label>Base de Datos</label>
                <div class="db-grid">
                    @foreach (var db in new[] {
                        ("PostgreSQL", "/img/logos/databases/postgresql.png", "Recomendado"),
                        ("MySQL",      "/img/logos/databases/mysql.png",      "Popular"),
                        ("SqlServer",  "/img/logos/databases/sqlserver.png",  "Empresarial"),
                        ("MongoDB",    "/img/logos/databases/mongodb.png",    "NoSQL"),
                        ("Redis",      "/img/logos/databases/redis.png",      "Cache/Cola"),
                        ("SQLite",     "/img/logos/databases/sqlite.png",     "Desarrollo")
                    })
                    {
                        <label class="db-card" data-value="@db.Item1">
                            <input type="radio" name="database" value="@db.Item1" />
                            <img src="@db.Item2" alt="@db.Item1" class="db-logo" onerror="this.style.display='none'" />
                            <span class="db-name">@db.Item1</span>
                            <span class="db-badge">@db.Item3</span>
                        </label>
                    }
                </div>
            </div>
        </div>

        <!-- ── Step 3: Infraestructura ────────────────────────────────────── -->
        <div class="wizard-step" data-step="3">
            <h2>Infraestructura y Despliegue</h2>
            <p class="step-voice-hint">Di: "Docker", "Kubernetes" o "sin contenedores"</p>

            <div class="infra-grid">
                <label class="infra-card" data-value="None">
                    <input type="radio" name="infrastructure" value="None" checked />
                    <span class="infra-icon">💻</span>
                    <strong>Sin contenedores</strong>
                    <span>Solo el código del proyecto</span>
                </label>
                <label class="infra-card" data-value="DockerCompose">
                    <input type="radio" name="infrastructure" value="DockerCompose" />
                    <img src="/img/logos/infra/docker.png" alt="Docker" class="infra-logo" onerror="this.style.display='none'" />
                    <strong>Docker Compose</strong>
                    <span>Ideal para desarrollo local y un solo servidor</span>
                </label>
                <label class="infra-card" data-value="Kubernetes">
                    <input type="radio" name="infrastructure" value="Kubernetes" />
                    <img src="/img/logos/infra/kubernetes.png" alt="Kubernetes" class="infra-logo" onerror="this.style.display='none'" />
                    <strong>Kubernetes</strong>
                    <span>Escalado horizontal, múltiples VPS</span>
                </label>
            </div>

            <!-- VPS Credentials (visible solo cuando Kubernetes) -->
            <div id="vps-section" style="display:none" class="vps-section mt-6">
                <h3>Servidores VPS</h3>
                <p class="text-muted">Agrega las credenciales SSH de cada nodo</p>
                <div id="vps-list"></div>
                <button type="button" class="btn btn-secondary" onclick="addVpsRow()">+ Agregar servidor</button>
            </div>
        </div>

        <!-- ── Step 4: Patrones & Librerías ─────────────────────────────── -->
        <div class="wizard-step" data-step="4">
            <h2>Patrones y Librerías</h2>

            <div class="ai-suggestion-banner" id="ai-banner">
                <span class="ai-icon"></span>
                <span id="ai-rationale">Analizando tu configuración con IA...</span>
            </div>
            <p class="step-description" style="font-size:.82rem;color:var(--text-muted);margin-top:.5rem">
                Se muestran todos los patrones y librerías disponibles para tu stack. La IA marcará sus sugerencias con ✦.
            </p>

            <div class="two-columns">
                <div>
                    <h3>Patrones de Diseño</h3>
                    <div id="patterns-list" class="checklist"></div>
                </div>
                <div>
                    <h3>Librerías Recomendadas</h3>
                    <div id="libraries-list" class="checklist"></div>
                </div>
            </div>
        </div>

        <!-- ── Step 5: Confirmar ─────────────────────────────────────────── -->
        <div class="wizard-step" data-step="5">
            <h2>Confirmar y Crear</h2>
            <p class="step-voice-hint">Di el nombre del proyecto, por ejemplo: "mi api de pagos"</p>

            <div class="summary-card">
                <div id="config-summary"></div>
            </div>

            <div class="form-group mt-6">
                <label>Nombre del proyecto / repositorio</label>
                <input type="text" name="projectName" id="project-name" class="form-input"
                       placeholder="mi-proyecto-genial" pattern="[a-zA-Z0-9_-]+" required />
                <small>Solo letras, números, guiones y guiones bajos</small>
            </div>

            <div class="form-group">
                <label>Descripción</label>
                <textarea name="description" class="form-textarea" rows="3"
                          placeholder="Descripción breve del proyecto..."></textarea>
            </div>

            <label class="checkbox-label">
                <input type="checkbox" name="createPrivateRepo" />
                Crear repositorio privado en GitHub
            </label>
        </div>

        <!-- Navigation Buttons -->
        <div class="wizard-nav">
            <button type="button" id="btn-prev" class="btn btn-ghost" onclick="prevStep()" style="display:none">
                ← Anterior
            </button>
            <button type="button" id="btn-next" class="btn btn-primary" onclick="nextStep()">
                Siguiente →
            </button>
            <button type="submit" id="btn-submit" class="btn btn-success" style="display:none">
                 Generar Proyecto
            </button>
            <button type="button" class="btn btn-ghost btn-icon" id="wizard-voice-mic"
                    title="Responder por voz" aria-label="Hablar"
                    onclick="window.__voiceWizardListen?.()"
                    style="border-color:rgba(34,211,238,.35);color:#22d3ee">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                    <line x1="12" y1="19" x2="12" y2="23"/>
                    <line x1="8" y1="23" x2="16" y2="23"/>
                </svg>
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script src="~/js/wizard.js"></script>
}

<!-- ═══════════════════════════════════════════════════════════════════════
     Modal: AVISO de herramientas no detectadas (NO BLOQUEANTE)
     ═══════════════════════════════════════════════════════════════════════ -->

<div id="prereq-modal-backdrop"
     class="prereq-modal-backdrop"
     style="display:none"
     aria-modal="true"
     role="dialog"
     aria-labelledby="prereq-modal-title">

    <div class="prereq-modal-box">

        <div class="prereq-modal-header">
            <span class="prereq-modal-icon">⚠️</span>
            <h3 class="prereq-modal-title" id="prereq-modal-title">
                Aviso de herramientas
            </h3>
        </div>

        <p class="prereq-modal-subtitle">
            Para generar proyectos con <strong id="prereq-arch-label"></strong>
            se recomienda tener instaladas las siguientes herramientas:
        </p>

        <ul id="prereq-tools-list" class="prereq-tools-list"></ul>

        <p class="prereq-modal-note">
            💡 Este aviso no bloquea la creación del proyecto.
            Si ya las instalaste, asegúrate de que estén en el <code>PATH</code>.
        </p>

        <div class="prereq-modal-actions">
            <button type="button" class="btn btn-ghost" onclick="closePrereqModal()">
                Cerrar
            </button>

            <button type="button" class="btn btn-primary" onclick="proceedAnywayPrereq()">
                Entendido
            </button>
        </div>

    </div>
</div>
